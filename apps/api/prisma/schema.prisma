generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserPlan {
  FREE
  PLUS
  PREMIUM
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model TelegramUser {
  id               String           @id @default(cuid())
  telegramId       BigInt           @unique
  telegramUsername String?
  firstName        String?
  lastName         String?
  language         String           @default("am")
  isActive         Boolean          @default(true)
  plan             UserPlan         @default(FREE)
  planExpiresAt    DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tickets          LotteryTicket[]
  payments         PaymentRequest[]

  @@map("telegram_users")
}

model LotteryTicket {
  id                 String       @id @default(cuid())
  telegramUserId     String
  user               TelegramUser @relation(fields: [telegramUserId], references: [id], onDelete: Cascade)
  ticketNumber       String
  originalSms        String       @db.Text
  expirationDateText String
  drawDateText       String
  isChecked          Boolean      @default(false)
  isWinner           Boolean      @default(false)
  matchedPrizeId     String?
  matchedPrize       DrawPrize?   @relation(fields: [matchedPrizeId], references: [id], onDelete: SetNull)
  checkedAt          DateTime?
  notifiedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([telegramUserId, ticketNumber, drawDateText])
  @@index([telegramUserId])
  @@index([drawDateText])
  @@index([ticketNumber])
  @@index([isWinner])
  @@map("lottery_tickets")
}

enum DrawStatus {
  DRAFT
  VERIFIED
  PUBLISHED
}

model LotteryDraw {
  id              String       @id @default(cuid())
  drawCode        String       @unique
  drawDateText    String
  status          DrawStatus   @default(DRAFT)
  sourceReference String?
  notes           String?      @db.Text
  verifiedAt      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  prizes          DrawPrize[]

  @@index([status])
  @@index([drawDateText])
  @@map("lottery_draws")
}

model DrawPrize {
  id             String          @id @default(cuid())
  drawId         String
  draw           LotteryDraw     @relation(fields: [drawId], references: [id], onDelete: Restrict)
  prizeName      String
  winningNumber  String
  prizeAmount    Decimal?        @db.Decimal(12, 2)
  currency       String          @default("ETB")
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  matchedTickets LotteryTicket[]

  @@unique([drawId, prizeName, winningNumber])
  @@index([drawId])
  @@index([winningNumber])
  @@map("draw_prizes")
}

/// Singleton-style settings row (use id = "default").
model PlatformSettings {
  id                String   @id @default("default")
  /// When false, ticket limits are not enforced — everyone can save freely.
  limitsEnabled     Boolean  @default(false)
  freeTicketLimit   Int      @default(5)
  plusTicketLimit   Int      @default(15)
  premiumTicketLimit Int     @default(30)
  plusPriceEtb      Decimal  @default(5) @db.Decimal(12, 2)
  premiumPriceEtb   Decimal  @default(15) @db.Decimal(12, 2)
  telebirrNumber    String   @default("")
  telebirrName      String   @default("")
  upgradeInfoAm     String?  @db.Text
  upgradeInfoEn     String?  @db.Text
  updatedAt         DateTime @updatedAt

  @@map("platform_settings")
}

model PaymentRequest {
  id              String        @id @default(cuid())
  telegramUserId  String
  user            TelegramUser  @relation(fields: [telegramUserId], references: [id], onDelete: Cascade)
  requestedPlan   UserPlan
  amountEtb       Decimal       @db.Decimal(12, 2)
  /// Telegram file_id for the payment screenshot
  screenshotFileId String?
  /// Optional caption / note from the user
  userNote        String?       @db.Text
  status          PaymentStatus @default(PENDING)
  adminNote       String?       @db.Text
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([telegramUserId])
  @@map("payment_requests")
}